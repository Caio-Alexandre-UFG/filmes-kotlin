<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MovieBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cores principais -->
        <item name="colorPrimary">@color/noir_grey</item>
        <item name="colorPrimaryVariant">@color/noir_black</item>
        <item name="colorOnPrimary">@color/noir_white</item>

        <item name="colorSecondary">@color/noir_red</item>
        <item name="colorOnSecondary">@color/noir_white</item>

        <!-- Plano de fundo e superfícies -->
        <item name="android:colorBackground">@color/noir_black</item>
        <item name="colorSurface">@color/noir_grey</item>
        <item name="colorOnSurface">@color/noir_white</item>

        <!-- Texto padrão -->
        <item name="android:textColorPrimary">@color/noir_white</item>

        <!-- Botões e bordas -->
        <item name="colorControlNormal">@color/noir_white</item>
        <item name="colorAccent">@color/noir_red</item>

        <!-- Compatibilidade para ícones claros -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>
</resources>
